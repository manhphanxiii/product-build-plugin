{
  "permissions": {
    "allow": [
      "Bash(npx -y lavish-axi *)",
      "Bash(command -v *)"
    ]
  },
  "extraKnownMarketplaces": {
    "manhphanxiii": {
      "source": {
        "source": "github",
        "repo": "manhphanxiii/product-build-plugin"
      }
    }
  },
  "enabledPlugins": {
    "build@manhphanxiii": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "claude plugin install build@manhphanxiii --scope project --yes",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
